<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="MediaDropNativeMessagingHost" Guid="*" Win64="yes">
        <File
          Id="MediaDropNativeMessagingManifest"
          Source="$(sys.SOURCEFILEDIR)..\..\native-messaging\generated\com.mab.mediadrop.json"
          Name="com.mab.mediadrop.json"
          KeyPath="yes"
        />
        <RegistryKey
          Root="HKLM"
          Key="SOFTWARE\Google\Chrome\NativeMessagingHosts\com.mab.mediadrop"
          ForceCreateOnInstall="yes"
          ForceDeleteOnUninstall="yes"
        >
          <RegistryValue Type="string" Value="[INSTALLDIR]com.mab.mediadrop.json" />
        </RegistryKey>
        <RegistryKey
          Root="HKLM"
          Key="SOFTWARE\Microsoft\Edge\NativeMessagingHosts\com.mab.mediadrop"
          ForceCreateOnInstall="yes"
          ForceDeleteOnUninstall="yes"
        >
          <RegistryValue Type="string" Value="[INSTALLDIR]com.mab.mediadrop.json" />
        </RegistryKey>
        <RegistryKey
          Root="HKLM"
          Key="SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\mediadrop.exe"
          ForceCreateOnInstall="yes"
          ForceDeleteOnUninstall="yes"
        >
          <RegistryValue Type="string" Value="[INSTALLDIR]mediadrop.exe" />
          <RegistryValue Name="Path" Type="string" Value="[INSTALLDIR]" />
        </RegistryKey>
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
